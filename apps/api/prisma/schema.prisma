generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  password       String
  name           String
  contactNumber  String   @unique
  createdAt      DateTime @default(now())
  sessionVersion Int      @default(0)

  paymentAccounts Json?

  memberships   Membership[]
  ownedGroups   Group[]        @relation("GroupOwner")
  payouts       Round[]        @relation("RoundRecipient")
  activities    Activity[]
  payments      Payment[]
  notifications Notification[]
}

model Group {
  id                    String              @id @default(uuid())
  name                  String              @unique
  description           String?
  contributionAmount    Int
  billingCycle          BillingCycle
  payoutSequence        PayoutSequence      @default(MANUAL)
  cycleDuration         Int
  maxMembers            Int
  inviteCode            String?             @unique
  organizerId           String
  isOrganizerParticipating Boolean          @default(true)
  organizerFeeAmount    Int                 @default(0)
  startDate             DateTime?
  gracePeriodDays       Int                 @default(0)
  latePenaltyAmount     Int                 @default(0)
  allowedPaymentMethods PaymentMethodType[]
  paymentDetails        String?
  createdAt             DateTime            @default(now())

  organizer     User           @relation("GroupOwner", fields: [organizerId], references: [id])
  memberships   Membership[]
  rounds        Round[]
  activities    Activity[]
  payments      Payment[]
  notifications Notification[]
}

model Round {
  id                          String      @id @default(uuid())
  groupId                     String
  cycleNumber                 Int
  roundNumber                 Int
  recipientId                 String
  targetDate                  DateTime
  status                      RoundStatus @default(PENDING)
  disbursedAt                 DateTime?
  receivedAt                  DateTime?
  disbursementReferenceNumber String?
  disbursementProofUrl        String?
  receiptNotes                String?
  updatedAt                   DateTime    @updatedAt

  group     Group     @relation(fields: [groupId], references: [id])
  recipient User      @relation("RoundRecipient", fields: [recipientId], references: [id])
  payments  Payment[]

  @@unique([groupId, cycleNumber, roundNumber])
}

model Membership {
  id                     String             @id @default(uuid())
  userId                 String
  groupId                String
  position               Int
  preferredPaymentMethod PaymentMethodType?
  paymentAccountDetails  String?
  joinedAt               DateTime           @default(now())

  user  User  @relation(fields: [userId], references: [id])
  group Group @relation(fields: [groupId], references: [id])

  @@unique([userId, groupId])
  @@unique([groupId, position])
}

model Payment {
  id                String            @id @default(uuid())
  groupId           String
  roundId           String
  userId            String
  paymentMethod     PaymentMethodType
  baseAmount        Int
  penaltyAmount     Int               @default(0)
  organizerFeeAmount Int              @default(0)
  totalAmount       Int
  referenceNumber   String?
  proofUrl          String?
  status            PaymentStatus     @default(PENDING)
  rejectionReason   String?
  rejectionProofUrl String?
  verifiedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  group Group @relation(fields: [groupId], references: [id])
  user  User  @relation(fields: [userId], references: [id])
  round Round @relation(fields: [roundId], references: [id])

  @@unique([groupId, roundId, userId])
}

model Activity {
  id          String       @id @default(uuid())
  userId      String
  groupId     String
  activity    ActivityType
  description String
  createdAt   DateTime     @default(now())

  user  User  @relation(fields: [userId], references: [id])
  group Group @relation(fields: [groupId], references: [id])

  @@index([groupId])
  @@index([userId])
}

model Notification {
  id               String           @id @default(uuid())
  userId           String
  groupId          String
  notificationType NotificationType
  description      String
  isRead           Boolean          @default(false)
  createdAt        DateTime         @default(now())

  user  User  @relation(fields: [userId], references: [id])
  group Group @relation(fields: [groupId], references: [id])

  @@index([groupId])
  @@index([userId])
}

enum ActivityType {
  PAYMENT
  PAYMENT_OVERDUE
  PAYMENT_VERIFIED
  PAYMENT_REJECTED
  PAYOUT_DISBURSED
  PAYOUT_RECEIVED
  PENALTY_APPLIED
  CYCLE_STARTED
  CYCLE_CLOSED
  ROTATED
  ANNOUNCEMENT
}

enum BillingCycle {
  DAILY
  WEEKLY
  BIMONTHLY
  MONTHLY
  QUARTERLY
}

enum RoundStatus {
  PENDING
  DISBURSED
  RECEIVED
}

enum PayoutSequence {
  RANDOM
  MANUAL
  FREECHOOSING
}

enum PaymentMethodType {
  E_WALLET
  BANK_TRANSFER
  CASH
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum NotificationType {
  PAYMENT
  PAYOUT
  REMINDER
  ANNOUNCEMENT
  SYSTEM
}
